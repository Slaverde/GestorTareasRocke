# Copia este archivo como .env y rellena los valores reales

# URL de tu base de datos PostgreSQL (te la da Dongee al crear la BD)
# Formato: postgresql://usuario:contraseña@host:5432/nombre_bd
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gestor_tareas

# Clave secreta para las sesiones (usa una cadena larga y aleatoria)
SECRET_KEY=cambia-esto-por-una-clave-segura-larga
